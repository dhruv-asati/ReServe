# Base URL of the ReServe backend, INCLUDING the /api prefix (every backend
# route is mounted under /api, so service paths in the code omit it).
# Restart `npm run dev` after changing this file.
# No API keys belong in this file or anywhere else in the frontend.
VITE_API_BASE_URL=http://localhost:8000/api

# Services return mock data unless this is exactly "false". Leave it commented
# out until the pages you are testing have been wired to the backend.
# VITE_USE_MOCKS=false
