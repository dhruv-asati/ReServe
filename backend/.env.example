# Copy this file to .env and fill in real values.
# Never commit the actual .env file.

# --- General ---
APP_NAME=ReServe API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# --- Database (Supabase PostgreSQL) ---
# From your Supabase project: Project Settings -> Database -> Connection string -> URI.
# Copy it, change "postgresql://" to "postgresql+psycopg2://", and paste it here.
#
# Two connection types Supabase offers — either works with this backend:
#   Direct connection (port 5432):
#     postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
#   Pooled/transaction mode via PgBouncer (port 6543 — better for serverless/many
#   short-lived connections, e.g. hackathon demo under load):
#     postgresql+psycopg2://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#
# Replace <PASSWORD> with your database password (set when you created the
# project) and <PROJECT-REF> with your project's reference ID. SSL is
# required by Supabase — the backend adds sslmode=require automatically if
# you don't include it yourself.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reserve_db

# --- JWT Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Gemini AI ---
GEMINI_API_KEY=
# Model POST /api/resources/{id}/analyze uses. Change if your API key
# doesn't have access to this model, or to use a different Gemini model.
GEMINI_MODEL=gemini-1.5-flash
# Seconds to wait for a Gemini response before failing the analyze
# request with a 504 instead of hanging.
GEMINI_TIMEOUT_SECONDS=20

# --- Supabase Storage ---
# From Project Settings -> API. Leave both blank to use local-disk storage
# instead (see LOCAL_UPLOAD_DIR below) — uploads still work without Supabase
# configured, which is the default for local development.
SUPABASE_URL=
SUPABASE_KEY=
# Storage bucket resource images are uploaded to. Must already exist in the
# Supabase project (public read access) before uploads will succeed.
SUPABASE_STORAGE_BUCKET=resource-images

# --- File uploads ---
MAX_UPLOAD_FILE_SIZE_MB=5
# Only used when Supabase Storage isn't configured — where uploaded files
# are written on local disk.
LOCAL_UPLOAD_DIR=uploads
# Only used when Supabase Storage isn't configured — prefix for the URL
# returned for a locally-stored upload. Set this to wherever the API is
# actually reachable (e.g. your ngrok URL) if testing from another device.
PUBLIC_BASE_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
